# ============================================================
#   PrismRAG — Configuration File
# ============================================================
#   HOW TO USE THIS FILE:
#     1. Lines starting with # are comments — they are ignored.
#     2. To ENABLE a setting: remove the # at the start of the line.
#     3. To DISABLE a setting: add a # at the start of the line.
#
#   QUICKSTART — Only these 2 things need your attention:
#     a) GOOGLE_AI_API_KEY  → paste your Gemini API key (Step 2)
#     b) DATABASE_URL       → update password if you set one (Step 1)
#
#   Get a free Gemini API key at: https://aistudio.google.com/apikey
# ============================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=PrismRAG
DEBUG=false
API_V1_PREFIX=/api/v1
# ["*"] allows all origins — fine for local development.
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# 2. DATABASE SETTINGS (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Default assumes PostgreSQL is running locally with no password change.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/prismrag

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE SETTINGS (ChromaDB or Qdrant)
# ------------------------------------------------------------------------------
# Choose your vector database: "chroma" or "qdrant"
VECTOR_DATABASE=chroma

# ChromaDB Settings (Local/Docker)
# ChromaDB vector store (runs locally on port 8002)
CHROMA_HOST=localhost
CHROMA_PORT=8002

# Qdrant Settings (Local/Docker/Cloud)
# Qdrant vector store (runs locally on port 6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_USE_HTTPS=false
QDRANT_PREFER_GRPC=false

# ------------------------------------------------------------------------------
# 4. AI PROVIDER SETTINGS (LLM & Embeddings)
# ------------------------------------------------------------------------------

# 4.1. LLM Provider (choose ONE block below: "gemini", "ollama", or "custom")
LLM_PROVIDER=gemini

# --- Option A: Gemini (recommended — active by default) ---
# Get your free API key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-gemini-api-key-here

# Which Gemini model to use for chat:
#   gemini-2.5-flash             → fast & capable (default)
#   gemini-2.5-pro               → most powerful, slower
#   gemini-2.5-flash-lite-preview → fastest & cheapest
LLM_MODEL_FAST=gemini-2.5-flash

# Thinking depth — controls how hard the model "thinks" before answering.
# Options: "minimal" | "low" | "medium" | "high"
# (Note: only applies to Gemini 3.x+ models; ignored for Gemini 2.5)
LLM_THINKING_LEVEL=medium

# Maximum tokens (words) the model can output per response.
# Gemini 2.5 Flash: up to 8192  |  Gemini 3.1 Flash-Lite: up to 65536
LLM_MAX_OUTPUT_TOKENS=8192

# --- Option B: Ollama (local/offline — inactive by default) ---
OLLAMA_HOST=http://localhost:11434
# Choose a model (uncomment ONE):
# OLLAMA_MODEL=qwen3.5:9b     # Multimodal, best quality
# OLLAMA_MODEL=qwen3.5:4b     # Multimodal, lighter
OLLAMA_MODEL=gemma3:12b      # Multimodal, Google
# Enable thinking mode for supported models like qwen3.x (default: false)
OLLAMA_ENABLE_THINKING=false

# --- Option C: Custom LLM Provider (external AI backend — inactive) ---
# Endpoint URL for the custom LLM backend
CUSTOM_LLM_ENDPOINT=
# Authentication type: "bearer" or "basic"
CUSTOM_LLM_AUTH_TYPE=bearer
# Authentication credentials: For bearer: API key | For basic: "username:password"
CUSTOM_LLM_AUTH_CREDENTIALS=
# Request timeout in seconds (default: 30)
CUSTOM_LLM_TIMEOUT=30
# Verify SSL certificates (default: true)
CUSTOM_LLM_VERIFY_SSL=true
# Model name to use in responses (default: "custom-llm")
CUSTOM_LLM_MODEL_NAME=custom-llm

# 4.2. Knowledge Graph (KG) Embedding Settings
# This can use a different provider than your chat LLM above.
KG_EMBEDDING_PROVIDER=gemini
KG_EMBEDDING_MODEL=gemini-embedding-001
KG_EMBEDDING_DIMENSION=3072

# For sentence_transformers (fully local):
# KG_EMBEDDING_PROVIDER=sentence_transformers
# KG_EMBEDDING_MODEL=BAAI/bge-m3
# KG_EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# 5. PRISMRAG PIPELINE & RETRIEVAL SETTINGS
# ------------------------------------------------------------------------------
# Safe to leave these at their defaults unless you have specific needs.

# Enable the RAG pipeline and Knowledge Graph features
PRISMRAG_ENABLED=true
PRISMRAG_ENABLE_KG=true

# Default language for the Knowledge Graph (can be overridden per workspace)
PRISMRAG_KG_LANGUAGE=English

# Entity types the KG will extract from your documents
PRISMRAG_KG_ENTITY_TYPES=["Organization","Person","Product","Location","Event","Financial_Metric","Technology","Date","Regulation"]

# Embedding & Reranking Models (downloaded during setup)
PRISMRAG_EMBEDDING_MODEL=BAAI/bge-m3
PRISMRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Toggle hybrid search (dense + sparse) if supported by your models
PRISMRAG_ENABLE_HYBRID_SEARCH=false

# Ingestion Settings
# Document parser: "docling" (default, best accuracy) or "marker" (lighter)
PRISMRAG_DOCUMENT_PARSER=docling
# Image handling — extract and caption images inside documents
PRISMRAG_ENABLE_IMAGE_EXTRACTION=true
PRISMRAG_ENABLE_IMAGE_CAPTIONING=true
# Max tokens per document chunk
PRISMRAG_CHUNK_MAX_TOKENS=512
# Stale document recovery — documents stuck "Processing" auto-fail after N minutes
PRISMRAG_PROCESSING_TIMEOUT_MINUTES=10

# Deduplication Settings — filters near-identical content before indexing
PRISMRAG_DEDUP_ENABLED=true
PRISMRAG_DEDUP_MIN_CHUNK_LENGTH=50   # Ignore chunks shorter than 50 characters
PRISMRAG_DEDUP_NEAR_THRESHOLD=0.85   # Similarity threshold (0.0–1.0; higher = stricter)

# Retrieval Quality Tuning
PRISMRAG_VECTOR_PREFETCH=20       # Candidates fetched before reranking
PRISMRAG_RERANKER_TOP_K=8         # Top results after reranking
PRISMRAG_MIN_RELEVANCE_SCORE=0.15 # Minimum score to include a result

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATION (Open WebUI / OpenAI API)
# ------------------------------------------------------------------------------
# Exposes OpenAI-compatible endpoints on the same server
PRISMRAG_OPENAI_COMPAT_ENABLED=true
# If set, clients must send: Authorization: Bearer <same value>
PRISMRAG_OPENAI_COMPAT_API_KEY=
# Rewrite /static/ links in assistant text for browsers on another origin
PRISMRAG_BACKEND_PUBLIC_ORIGIN=http://localhost:8080
