# PrismRAG Frontend Environment Variables
# ========================================

# API base URL — default uses Vite proxy (dev) or nginx proxy (Docker)
# Only override if backend is on a different host/port
# VITE_API_URL=/api/v1

# Vite dev server proxy target (same machine as Vite: keep default).
# If the backend runs elsewhere, set to that origin, e.g. http://192.168.1.10:8080
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
